+#if defined(GGML_USE_HIP)
+// Flash-Next HC up projection: a wave32 reduces one short row, with two
+// independent rows per block. Avoid shared-memory reductions across five waves.
+static __global__ void hip_hc_up_bf16(const uint32_t * x, const float2 * y, float * dst) {
+    const int lane = threadIdx.x & 31;
+    const int row = blockIdx.x * 2 + threadIdx.x / 32;
+    float sum = 0.0f;
+#pragma unroll
+    for (int j = 0; j < 5; ++j) {
+        const int col = lane + j * 32;
+        const uint32_t w = x[row * 160 + col];
+        const float2 v = y[col];
+        sum = fmaf(__uint_as_float(w << 16), v.x, sum);
+        sum = fmaf(__uint_as_float(w & 0xffff0000u), v.y, sum);
+    }
+#pragma unroll
+    for (int offset = 16; offset > 0; offset /= 2) {
+        sum += __shfl_down(sum, offset, 32);
+    }
+    if (lane == 0) {
+        dst[row] = sum;
+    }
+}
+#endif
 
