+#if defined(GGML_USE_HIP)
+// Two Q6_K contributions per lane expose independent work; each wave owns a row.
+template<int Waves>
+static __global__ void hip_q6_pair(const block_q6_K * w, const block_q8_1 * x, float * dst,
+                                   const uint32_t cols, const uint32_t rows) {
+    const uint32_t row = blockIdx.x * Waves + threadIdx.y;
+    const uint32_t lane = threadIdx.x;
+    if (row >= rows) { return; }
+    float sum0 = 0.0f, sum1 = 0.0f;
+    for (uint32_t b = lane / 16; b < cols / QK_K; b += 2) {
+        const int block = row * (cols / QK_K) + b;
+        const int iq = 2 * (lane % 16);
+        sum0 += vec_dot_q6_K_q8_1(w, x + b * (QK_K / QK8_1), block, iq);
+        sum1 += vec_dot_q6_K_q8_1(w, x + b * (QK_K / QK8_1), block, iq + 1);
+    }
+    const float sum = warp_reduce_sum<32>(sum0 + sum1);
+    if (lane == 0) { dst[row] = sum; }
+}
+#endif
