+#if defined(GGML_USE_HIP)
+// HC down and router projections: independent rows share a block, and
+// two float accumulators shorten each lane's dot-product dependency chain.
+template<int Cols>
+static __global__ void hip_dense_bf16(const uint32_t * x, const float2 * y, float * dst) {
+    const int lane = threadIdx.x & 31;
+    const int row = blockIdx.x * 2 + threadIdx.x / 32;
+    float sum0 = 0.0f, sum1 = 0.0f;
+#pragma unroll 4
+    for (int j = 0; j < Cols / 64; ++j) {
+        const int col = lane + j * 32;
+        const uint32_t w = x[row * (Cols / 2) + col];
+        const float2 v = y[col];
+        sum0 = fmaf(__uint_as_float(w << 16), v.x, sum0);
+        sum1 = fmaf(__uint_as_float(w & 0xffff0000u), v.y, sum1);
+    }
+    float sum = sum0 + sum1;
+#pragma unroll
+    for (int offset = 16; offset > 0; offset /= 2) {
+        sum += __shfl_down(sum, offset, 32);
+    }
+    if (lane == 0) {
+        dst[row] = sum;
+    }
+}
+#endif
 
